# MongoDB Atlas database URI. Keep server-side only.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Local site origin and Vite API base. Production APP_URL must be HTTPS.
APP_URL=http://localhost:5173
VITE_API_BASE_URL=/api
NODE_ENV=development
PORT=4000

# Initial administrator. Used only by npm run seed:admin.
SEED_ADMIN_NAME=Library Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password-of-at-least-12-characters
JWT_SECRET=replace-with-at-least-32-random-characters
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# SMTP provider. Leave the entire group unset to disable email delivery.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
MAIL_FROM=Library Management <no-reply@example.com>
